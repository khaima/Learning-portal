# Copy to .env (git ignores it) and fill in. Used only by
# scripts/configure-auth.mjs on your own computer — see docs/AUTH.md.
# Never commit real values, and never put them in the website's files.

SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=fwpqytrdlmxymvegvgji

# resend | brevo | custom
SMTP_PROVIDER=resend
SMTP_SENDER_EMAIL=no-reply@humanpractice.org
SMTP_SENDER_NAME=HPF Digital Learning Portal
SMTP_RATE_LIMIT_PER_HOUR=30

# Resend
RESEND_API_KEY=

# Brevo (the API key — not the SMTP key — is for invitation emails)
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_API_KEY=

# Any other SMTP server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
